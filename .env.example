# Copie ce fichier en `.env` (non commité) et colle ta clé pour activer la vraie
# estimation IA de la caméra (proxy local Claude vision, endpoint /api/match-camera).
# Sans clé, l'app retombe sur une estimation heuristique locale (badge "estimated").
ANTHROPIC_API_KEY=

# Optionnel — modèle vision utilisé (défaut: claude-sonnet-5)
# AI_MODEL=claude-sonnet-5
